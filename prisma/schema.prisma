generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         String        @default("user")
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobPositions JobPosition[]
  resumes      Resume[]

  @@map("users")
}

model JobPosition {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobName          String                                          // 岗位名称（必填）
  companyName      String                                          // 公司名称（必填）
  salary           Float                                           // 薪资（k），1-100，1位小数（必填）
  requirements     String?  @db.Text                               // 岗位要求
  responsibilities String?  @db.Text                               // 岗位职责
  attractiveness   String?  @db.Text                               // 岗位吸引力
  rating           Int      @default(3)                            // 心动等级 1-5
  sourcePlatform   String   @default("招聘平台")                    // 招聘平台 | 朋友推荐 | 官网
  status           String   @default("待投递")                      // 待投递/已投递/待面试/面试中/面试结果待反馈/面试通过/面试失败/已归档
  remark           String?  @db.Text                               // 面试备注（用户自填）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@map("job_positions")
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String                                          // 简历标题（必填）
  content     String   @db.Text                               // 简历文本内容，Markdown 格式（必填）
  description String?  @db.Text                               // 备注/描述（可选）
  fileName    String?                                         // 文件名（未来上传预留）
  fileUrl     String?                                         // OSS 地址（未来上传预留）
  fileType    String?                                         // 文件类型（预留）
  fileSize    Int?                                            // 文件大小（预留）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("resumes")
}
